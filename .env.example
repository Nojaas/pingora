# App
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace (défaut: debug en dev, info en prod)
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pingora

# Redis
REDIS_URL=redis://localhost:6379
# Fenêtre glissante du rate limit (ms, défaut 60000 = 1 min)
RATE_LIMIT_WINDOW_MS=60000

# Auth interne (pour créer des clés admin au seed)
ADMIN_SECRET=change_me_in_prod

# Métriques Prometheus — GET /metrics (Bearer ou x-metrics-token)
METRICS_SECRET=metrics_dev_change_me

# Webhooks entrants (HMAC) — POST /webhooks/inbound
INBOUND_WEBHOOK_SECRET=whsec_dev_inbound_change_me

# Email — nodemailer + Mailpit (défaut) | ses + LocalStack | Resend SMTP (prod)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
# Auth optionnelle (requis pour Resend / SMTP réel)
SMTP_USER=
SMTP_PASS=
# true | false — défaut: true si port 465
SMTP_SECURE=
SMTP_FROM=pingora@localhost
# Resend (Railway) :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=<RESEND_API_KEY>
#   SMTP_FROM=onboarding@resend.dev
RESEND_API_KEY=

# SMS (Twilio — utilise un mock en dev)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS / LocalStack (EMAIL_PROVIDER=ses)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Dashboard (Next.js :3002) — clé créée par pnpm db:seed
PINGORA_API_URL=http://localhost:3000
PINGORA_API_KEY=
