# App
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace (défaut: debug en dev, info en prod)
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pingora

# Redis
REDIS_URL=redis://localhost:6379
# Fenêtre glissante du rate limit (ms, défaut 60000 = 1 min)
RATE_LIMIT_WINDOW_MS=60000

# Auth interne (pour créer des clés admin au seed)
ADMIN_SECRET=change_me_in_prod

# Webhooks entrants (HMAC) — POST /webhooks/inbound
INBOUND_WEBHOOK_SECRET=whsec_dev_inbound_change_me

# Email (Resend en prod, nodemailer + Mailpit en dev)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pingora@localhost
RESEND_API_KEY=

# SMS (Twilio — utilise un mock en dev)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS / LocalStack
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
